# ============================================================
# RepoPulse AI — Environment Variables
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` to version control.
# ============================================================

# Flask
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# GitHub REST API
# Token for fetching PR diffs and posting review comments
# Needs 'repo' scope (private repos) or 'public_repo' (public repos)
GITHUB_TOKEN=ghp_your_personal_access_token_here

# RAG / Doc-Bot
# Absolute path to the local repository to index for the knowledge base
# e.g. REPO_PATH=/home/user/my-project  or  REPO_PATH=. (current directory)
REPO_PATH=.

# GitHub Webhook
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here

# Google Gemini API
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the default model
GEMINI_MODEL=gemini-1.5-pro-latest

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG
